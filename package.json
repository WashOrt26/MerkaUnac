{
  "name": "merkaunac",
  "version": "1.0.0",
  "description": "Plataforma web de promoción comunitaria para la Corporación Universitaria Adventista (UNAC), enfocada en la compra, venta e intercambio de productos dentro del entorno universitario.",
  "scripts": {
    "dev": "vite --config frontend/vite.config.js",
    "server": "node backend/server/index.js",
    "dev:full": "concurrently -n api,web -c blue,green \"npm run server\" \"npm run dev\"",
    "build": "vite build --config frontend/vite.config.js",
    "preview": "vite preview --config frontend/vite.config.js",
    "lint": "eslint --config frontend/eslint.config.js \"frontend/src/**/*.{js,jsx}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WashOrt26/MerkaUnac.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/WashOrt26/MerkaUnac/issues"
  },
  "homepage": "https://github.com/WashOrt26/MerkaUnac#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "vite": "^8.0.8"
  }
}
